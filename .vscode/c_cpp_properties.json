{
    "configurations": [
        {
            "name": "Nintendo Switch - devkitPro",
            "includePath": [
                "${workspaceFolder}/**",
                "${env:DEVKITPRO}/libnx/include"
            ],
            "defines": [
                "__SWITCH__"
            ],
            "compilerPath": "${env:DEVKITPRO}/devkitA64/bin/aarch64-none-elf-gcc.exe",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "gcc-arm64"
        }
    ],
    "version": 4
}